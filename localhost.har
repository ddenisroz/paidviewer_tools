r(--quality-common));\\r\\n}\\r\\n\\r\\n.border-quality-rare {\\r\\n  border-color: hsl(var(--quality-rare));\\r\\n}\\r\\n\\r\\n.border-quality-epic {\\r\\n  border-color: hsl(var(--quality-epic));\\r\\n}\\r\\n\\r\\n.border-quality-legendary {\\r\\n  border-color: hsl(var(--quality-legendary));\\r\\n}\\r\\n\\r\\n.border-quality-mythical {\\r\\n  border-color: hsl(var(--quality-mythical));\\r\\n}\\r\\n\\r\\n/* === Стандартизированные отступы === */\\r\\n/* Используем Tailwind spacing, но для консистентности добавляем утилиты */\\r\\n.spacing-xs { gap: 0.5rem; }\\r\\n.spacing-sm { gap: 0.75rem; }\\r\\n.spacing-md { gap: 1rem; }\\r\\n.spacing-lg { gap: 1.5rem; }\\r\\n.spacing-xl { gap: 2rem; }\\r\\n\\r\\n/* === Стандартизированные радиусы скругления === */\\r\\n.radius-card { border-radius: calc(var(--radius) + 2px); }\\r\\n.radius-button { border-radius: var(--radius); }\\r\\n.radius-input { border-radius: calc(var(--radius) - 2px); }\\r\\n\\r\\n/* === Стандартизированные тени === */\\r\\n.shadow-card {\\r\\n  box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);\\r\\n}\\r\\n\\r\\n.shadow-elevated {\\r\\n  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\\r\\n}\\r\\n\\r\\n/* === Переходы === */\\r\\n.transition-standard {\\r\\n  transition-property: all;\\r\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\r\\n  transition-duration: 200ms;\\r\\n}\\r\\n\\r\\n.transition-slow {\\r\\n  transition-property: all;\\r\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\r\\n  transition-duration: 300ms;\\r\\n}\\r\\n\\r\\n/* === Focus states === */\\r\\n.focus-ring {\\r\\n  outline: 2px solid transparent;\\r\\n  outline-offset: 2px;\\r\\n}\\r\\n\\r\\n.focus-ring:focus-visible {\\r\\n  outline: 2px solid hsl(var(--ring));\\r\\n  outline-offset: 2px;\\r\\n}\\r\\n\\r\\n/* === Loading states === */\\r\\n.loading-pulse {\\r\\n  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\\r\\n}\\r\\n\\r\\n@keyframes pulse {\\r\\n  0%, 100% {\\r\\n    opacity: 1;\\r\\n  }\\r\\n  50% {\\r\\n    opacity: 0.5;\\r\\n  }\\r\\n}\\r\\n\\r\\n\"\n__vite__updateStyle(__vite__id, __vite__css)\nimport.meta.hot.accept()\nimport.meta.hot.prune(() => __vite__removeStyle(__vite__id))"
