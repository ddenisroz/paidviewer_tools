ризации: ${error}`);\n          setTimeout(() => navigate(\"/settings\"), 3e3);\n          return;\n        }\n        if (!code) {\n          setStatus(\"Код авторизации не получен\");\n          setTimeout(() => navigate(\"/settings\"), 3e3);\n          return;\n        }\n        setStatus(\"Обмен кода на токен...\");\n        const response = await fetch(`${API_BASE_URL}/auth/donationalerts/callback?code=${code}&state=${state || \"\"}`);\n        if (response.ok) {\n          const result = await response.json();\n          setStatus(\"Успешно подключено к DonationAlerts!\");\n          window.dispatchEvent(new CustomEvent(\"donationalerts_connected\", {\n            detail: { success: true, user_id: result.user_id }\n          }));\n          window.dispatchEvent(new CustomEvent(\"auth_refresh_required\"));\n          setTimeout(() => navigate(\"/settings\"), 2e3);\n        } else {\n          const error2 = await response.json();\n          setStatus(`Ошибка: ${error2.detail || \"Неизвестная ошибка\"}`);\n          setTimeout(() => navigate(\"/settings\"), 3e3);\n        }\n      } catch (error) {\n        logger.error(\"DonationAlerts callback error:\", error);\n        setStatus(`Ошибка: ${error.message}`);\n        setTimeout(() => navigate(\"/settings\"), 3e3);\n      }\n    };\n    handleCallback();\n  }, [navigate]);\n  return /* @__PURE__ */ jsxDEV(\"div\", { className: \"min-h-screen bg-gray-900 flex items-center justify-center\", children: /* @__PURE__ */ jsxDEV(\"div\", { className: \"bg-gray-800 p-8 rounded-lg shadow-lg text-center\", children: [\n    /* @__PURE__ */ jsxDEV(\"div\", { className: \"animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500 mx-auto mb-4\" }, void 0, false, {\n      fileName: \"H:/Programming/raw_code/AI/Python/TTS_TTV_0.02/frontend/src/pages/DonationAlertsCallback.jsx\",\n      lineNumber: 85,\n      columnNumber: 9\n    }, this),\n    /* @__PURE__ */ jsxDEV(\"h2\", { className: \"text-xl font-semibold text-white 