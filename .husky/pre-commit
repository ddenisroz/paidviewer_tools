#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."
echo ""

# Change to frontend directory
cd frontend || exit 1

# Run all checks using the check:all script
echo "🚀 Running all checks (lint + format + type-check)..."
npm run check:all
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Pre-commit checks failed!"
  echo ""
  echo "💡 To fix issues:"
  echo "   - Lint errors: npm run lint:fix"
  echo "   - Format errors: npm run format"
  echo "   - Type errors: check TypeScript errors and fix manually"
  echo ""
  exit 1
fi
echo "✅ All checks passed!"
echo ""

# Return to root for design system check
cd ..

# Design System Check
echo "🎨 Checking Design System compliance..."
npm run check:design
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Design System check failed!"
  echo ""
  echo "💡 To fix automatically, run:"
  echo "   npm run migrate:design:apply"
  echo ""
  echo "📚 Or check the guide:"
  echo "   docs/DESIGN_SYSTEM.md"
  echo ""
  exit 1
fi
echo "✅ Design System passed!"
echo ""

echo "🎉 All checks passed! Committing..."
