# ===================================
# TTS SERVICE SIMPLE - ENVIRONMENT CONFIGURATION
# ===================================
# Simplified TTS service for personal use with F5-TTS
# No Redis required - perfect for single user deployment
# Copy this file to .env and fill in your values

# === ENVIRONMENT ===
# Environment mode: development, production
ENVIRONMENT=development
# Enable debug mode
DEBUG=true
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# === SERVICE CONFIGURATION ===
# TTS service host (0.0.0.0 for all interfaces)
TTS_SIMPLE_HOST=0.0.0.0
# TTS service port (use 8001 for compatibility with bot_service)
TTS_SIMPLE_PORT=8001
# Bot service URL (for authentication and callbacks)
BOT_SERVICE_URL=http://localhost:8000

# === SECURITY ===
# Secret key for JWT validation (MUST match bot_service SECRET_KEY)
SECRET_KEY=your-secret-key-here-must-match-bot-service
# JWT algorithm
ALGORITHM=HS256
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# === F5-TTS CONFIGURATION ===
# F5-TTS model path
F5_TTS_MODEL_PATH=./models/f5_tts
# Device for F5-TTS: cuda (GPU), cpu, mps (Mac)
F5_TTS_DEVICE=cuda
# Maximum concurrent workers
F5_TTS_MAX_WORKERS=2
# GPU priority mode: performance (faster, more VRAM) or quality (slower, less VRAM)
GPU_PRIORITY=performance
# Maximum VRAM usage in GB (0 = use all available)
GPU_MAX_VRAM_GB=0

# === TTS SETTINGS ===
# Maximum text length for TTS generation (characters)
TTS_MAX_TEXT_LENGTH=500
# Default voice
TTS_DEFAULT_VOICE=female_russian
# TTS generation timeout (seconds)
TTS_GENERATION_TIMEOUT=30

# === VOICE STORAGE ===
# Base directory for voice files
VOICES_DIR=./voices
# Voice storage structure:
#   voices/user_{user_id}/  - User's custom voices
#   voices/global/          - Downloaded global voices

# === GLOBAL VOICE REPOSITORY ===
# URL of global voice pack repository (optional)
GLOBAL_VOICES_REPO=https://tts-voices.example.com
# Enable automatic voice pack updates
AUTO_UPDATE_VOICES=false

# === AUDIO SETTINGS ===
# Audio sample rate (Hz)
SAMPLE_RATE=22050
AUDIO_SAMPLE_RATE=22050
# Audio format: wav, mp3, ogg
AUDIO_FORMAT=wav
# Audio output directory
AUDIO_OUTPUT_DIR=./audio
# Maximum audio file size (bytes)
MAX_AUDIO_FILE_SIZE=10485760

# === PERFORMANCE ===
# Maximum concurrent TTS requests
MAX_CONCURRENT_REQUESTS=3
# Request timeout (seconds)
REQUEST_TIMEOUT=30

# === LOGGING ===
# Log file path
LOG_FILE=logs/tts_simple.log
# Log directory
LOG_DIR=./logs
# Enable JSON formatted logs
ENABLE_JSON_LOGS=false
# Enable log rotation
ENABLE_LOG_ROTATION=true

# === CLOUDFLARE TUNNEL (Production) ===
# Cloudflare Tunnel token (for secure remote access)
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# === PRODUCTION SETTINGS ===
# For production deployment, update these values:
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=WARNING
# ENABLE_JSON_LOGS=true
# MAX_CONCURRENT_REQUESTS=5
