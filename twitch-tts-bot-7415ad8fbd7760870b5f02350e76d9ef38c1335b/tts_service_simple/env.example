# TTS F5 Simple - Упрощенная версия
# ВСЕ НАСТРОЙКИ ОПЦИОНАЛЬНЫ! Работает без .env файла

# === GPU НАСТРОЙКИ (опционально) ===
# Ограничить использование VRAM (в ГБ, 0 = использовать всю доступную)
# GPU_MAX_VRAM_GB=8

# Режим работы (по умолчанию: performance)
# performance - быстрее, больше нагрузка на GPU
# quality - медленнее, меньше нагрузка на GPU
# GPU_PRIORITY=performance

