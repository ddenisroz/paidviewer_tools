# ========================================
# TTS_TTV TTS Service - РЕАЛЬНАЯ КОНФИГУРАЦИЯ
# ========================================

# ========================================
# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ
# ========================================

# Server
HOST=0.0.0.0                    # IP адрес сервера (0.0.0.0 = все интерфейсы)
PORT=8001                       # Порт для TTS сервиса

# Audio
AUDIO_CACHE_DIR=audio_cache     # Папка для кэша аудио файлов
VOICES_DIR=voices               # Папка с голосовыми файлами (.wav)
DEFAULT_VOICE=speaker1.wav      # Голос по умолчанию (файл из voices/)

# ========================================
# ОПЦИОНАЛЬНЫЕ НАСТРОЙКИ
# ========================================

# TTS Settings
DEFAULT_SPEED=1.0               # Скорость речи (1.0 = нормальная)
DEFAULT_SILENCE_DURATION=100    # Пауза в конце (мс)
ENABLE_YOFICATION=true          # Включить ёфикацию (ё вместо е)
ENABLE_ACCENTS=true             # Включить ударения (+у+дарение)

# Logging
LOG_LEVEL=INFO                  # Уровень логирования (DEBUG/INFO/WARNING/ERROR)
