# bot_service minimal env example
# Copy to .env and change only the values you actually use.
# Advanced overrides are intentionally omitted here; they keep working via defaults in bot_service/core/config.py.

# Core runtime
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=replace-with-openssl-rand-hex-32
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
DATABASE_URL=postgresql://user:password@localhost:5432/bot_service_db

# App URLs
BOT_SERVICE_HOST=0.0.0.0
BOT_SERVICE_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# TTS upstreams
TTS_GATEWAY_URL=http://localhost:8010
TTS_GATEWAY_API_KEY=
F5_TTS_SERVICE_URL=http://localhost:8011
F5_TTS_SERVICE_API_KEY=
QWEN_TTS_SERVICE_URL=http://localhost:8012
QWEN_TTS_SERVICE_API_KEY=
QWEN_VOICE_SERVICE_URL=
# Leave empty when self-hosted Qwen is pinned to one exact model via QWEN3_TTS_MODEL_PATH.
QWEN_ALLOWED_MODELS=
# Optional backend-only override. Usually leave empty.
# QWEN_CLOUD_ALLOWED_MODELS=

# OAuth: Twitch user login
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/auth/twitch/callback

# OAuth: VK user login
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:8000/auth/vk/callback

# Common optional integrations
GOOGLE_CLOUD_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
YOUTUBE_API_KEY=
DONATIONALERTS_CLIENT_ID=
DONATIONALERTS_CLIENT_SECRET=
DONATIONALERTS_REDIRECT_URI=http://localhost:8000/auth/donationalerts/callback
DONATIONALERTS_WEBHOOK_SECRET=
