# ===============================================================================
# BOT SERVICE - ENVIRONMENT CONFIGURATION
# ===============================================================================
# Скопируйте этот файл в .env и заполните значениями
# Генерация секретов:
#   SECRET_KEY:          openssl rand -hex 32
#   TOKEN_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# === ОСНОВНЫЕ НАСТРОЙКИ ===
ENVIRONMENT=development          # development | production
DEBUG=true                       # true = подробные ошибки, false = для прода
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# === БЕЗОПАСНОСТЬ ===
SECRET_KEY=сгенерируй-openssl-rand-hex-32
ALGORITHM=HS256
TOKEN_ENCRYPTION_KEY=сгенерируй-fernet-ключ

# === АДРЕСА СЕРВИСОВ ===
BOT_SERVICE_HOST=0.0.0.0         # Хост для запуска (0.0.0.0 = все интерфейсы)
BOT_SERVICE_PORT=8000            # Порт API
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
TTS_SERVICE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === БАЗА ДАННЫХ ===
# PostgreSQL (рекомендуется): postgresql://user:pass@host:5432/dbname
# SQLite (для разработки):    sqlite:///./data/bot_service.db
DATABASE_URL=postgresql://user:password@localhost:5432/bot_service_db

# Лимиты сообщений в БД
CHAT_MESSAGES_DB_LIMIT_PER_USER=3000   # Макс сообщений на пользователя
CHAT_MESSAGES_DB_LIMIT_TOTAL=100000    # Макс сообщений всего
CHAT_MESSAGES_RETENTION_DAYS=30        # Хранить сообщения N дней

# === RATE LIMITING (ограничение запросов) ===
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=60
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LOGIN=5/15minute      # 5 попыток входа за 15 минут
RATE_LIMIT_TTS=30/minute
MAX_LOGIN_ATTEMPTS=10

# === TWITCH ИНТЕГРАЦИЯ ===
# Получить: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=твой-twitch-client-id
TWITCH_CLIENT_SECRET=твой-twitch-client-secret
TWITCH_REDIRECT_URI=http://localhost:8000/auth/twitch/callback
# Bot token is not configured in .env.
# Use admin OAuth flow: /auth/twitch/bot/login (stored in DB table bot_tokens).

# === VK LIVE ИНТЕГРАЦИЯ ===
# Получить: https://vk.com/apps?act=manage
VK_CLIENT_ID=твой-vk-client-id
VK_CLIENT_SECRET=твой-vk-client-secret
VK_REDIRECT_URI=http://localhost:8000/auth/vk/callback
VK_AUTH_BASE_URL=https://auth.live.vkvideo.ru/app/oauth2/authorize
# VK bot token is not configured in .env.
# Use admin OAuth flow: /auth/vk/bot/login (stored in DB table bot_tokens).

# === YOUTUBE / GOOGLE CLOUD ===
GOOGLE_CLOUD_API_KEY=твой-google-api-key
# Optional for ADC-based Gemini TTS requests (x-goog-user-project).
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# === DONATION ALERTS ===
DONATIONALERTS_CLIENT_ID=твой-da-client-id
DONATIONALERTS_CLIENT_SECRET=твой-da-client-secret
DONATIONALERTS_REDIRECT_URI=http://localhost:8000/auth/donationalerts/callback

# === ВНЕШНИЕ API ===
HUGGINGFACE_TOKEN=hf_твой_токен       # Для TTS моделей
DEEPSEEK_API_KEY=sk-твой-ключ         # Для AI анализа чата
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# === GTTS ГОЛОС ===
# Варианты: com (US), co.uk (UK), com.au (AU), ru (RU) и др.
GTTS_VOICE=com

# === ЛОГИРОВАНИЕ ===
LOG_FILE=logs/bot_service.log    # Путь к файлу логов
LOG_FILE_LEVEL=WARNING           # DEBUG | INFO | WARNING | ERROR
ENABLE_LOG_ROTATION=true         # Автоматическая ротация логов

# ===============================================================================
# PRODUCTION CHECKLIST (что изменить для прода):
# ===============================================================================
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=WARNING
# Сгенерировать новые SECRET_KEY и TOKEN_ENCRYPTION_KEY
# Использовать PostgreSQL вместо SQLite
