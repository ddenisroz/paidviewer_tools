# ==============================================================================
# bot_service/.env.example
# Copy to .env and fill values.
# ==============================================================================

# --- Runtime mode ---
# development | production
ENVIRONMENT=development
# true = verbose errors/logs
DEBUG=true
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Security ---
# Generate: openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32
ALGORITHM=HS256
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key

# --- Service URLs / network ---
BOT_SERVICE_HOST=0.0.0.0
BOT_SERVICE_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
TTS_GATEWAY_URL=http://localhost:8010
# Used by bot_service -> tts-gateway. Also acts as shared fallback for direct F5/Qwen upstream auth when provider-specific keys are empty.
TTS_GATEWAY_API_KEY=
F5_TTS_SERVICE_URL=http://localhost:8011
# Optional dedicated F5 upstream key. If empty, bot_service falls back to TTS_INTERNAL_API_KEY and then TTS_GATEWAY_API_KEY.
F5_TTS_SERVICE_API_KEY=
QWEN_TTS_SERVICE_URL=http://localhost:8012
# Optional dedicated Qwen upstream key. If empty, bot_service falls back to TTS_INTERNAL_API_KEY and then TTS_GATEWAY_API_KEY.
QWEN_TTS_SERVICE_API_KEY=
# Optional dedicated Qwen voice CRUD upstream. If empty, bot_service falls back to QWEN_TTS_SERVICE_URL.
QWEN_VOICE_SERVICE_URL=
# Optional: local filesystem root of extracted F5 service (for maintenance stats/cleanup only)
F5_TTS_STORAGE_ROOT=
# Optional shared fallback key for direct F5/Qwen upstream auth when provider-specific keys are not set.
TTS_INTERNAL_API_KEY=
# Internal service JWT settings are kept for non-TTS legacy integrations.
INTERNAL_SERVICE_JWT_ENABLED=true
INTERNAL_SERVICE_JWT_ISSUER=bot_service
INTERNAL_SERVICE_JWT_AUDIENCE_TTS=f5_tts
# Optional dedicated secret. If empty, SECRET_KEY is used.
INTERNAL_SERVICE_JWT_SECRET=
INTERNAL_SERVICE_JWT_TTL_SECONDS=120
# Optional mTLS (for HTTPS internal service mesh)
INTERNAL_SERVICE_MTLS_ENABLED=false
INTERNAL_SERVICE_CA_CERT_PATH=
INTERNAL_SERVICE_CLIENT_CERT_PATH=
INTERNAL_SERVICE_CLIENT_KEY_PATH=
# Comma-separated
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Local TTS endpoint security (SSRF hardening):
# bot_service will accept only these hosts/CIDRs for user-defined local endpoint URLs.
LOCAL_TTS_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,f5_tts,tts_service,qwen_tts,qwen_service
LOCAL_TTS_ALLOWED_CIDRS=127.0.0.0/8,::1/128

# --- Database ---
# PostgreSQL only
DATABASE_URL=postgresql://user:password@localhost:5432/bot_service_db

# Chat message retention limits
CHAT_MESSAGES_DB_LIMIT_PER_USER=3000
CHAT_MESSAGES_DB_LIMIT_TOTAL=100000
CHAT_MESSAGES_RETENTION_DAYS=30

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=60
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LOGIN=5/15minute
RATE_LIMIT_TTS=30/minute
MAX_LOGIN_ATTEMPTS=10

# --- Twitch OAuth (user login) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/auth/twitch/callback
# Bot token is NOT stored in .env. Use /auth/twitch/bot/login (saved in DB bot_tokens).

# --- VK OAuth (user login) ---
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:8000/auth/vk/callback
VK_AUTH_BASE_URL=https://auth.live.vkvideo.ru/app/oauth2/authorize
# Only for local troubleshooting with broken cert chain
VK_INSECURE_SSL=false
# Bot token is NOT stored in .env. Use /auth/vk/bot/login (saved in DB bot_tokens).

# --- Integrations ---
YOUTUBE_API_KEY=
DONATIONALERTS_CLIENT_ID=
DONATIONALERTS_CLIENT_SECRET=
DONATIONALERTS_REDIRECT_URI=http://localhost:8000/auth/donationalerts/callback
# Shared secret used by /api/drops/donationalerts/webhook (header/query secret)
DONATIONALERTS_WEBHOOK_SECRET=

# --- External APIs ---
GOOGLE_CLOUD_API_KEY=
# Optional fallback alias (if code expects GOOGLE_TTS_API_KEY)
GOOGLE_TTS_API_KEY=
# Optional for ADC quota project / x-goog-user-project
GOOGLE_CLOUD_PROJECT_ID=
HUGGINGFACE_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Chat analysis defaults ---
CHAT_ANALYSIS_CHANNEL_LIMIT=80
CHAT_ANALYSIS_GLOBAL_LIMIT=200
CHAT_ANALYSIS_MIN_MESSAGES=10
CHAT_ANALYSIS_OUTPUT_MAX_CHARS=150
CHAT_ANALYSIS_SAVE_RESULTS=false

# --- Redis / Celery (if used) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- TTS fallback voice ---
# gTTS TLD: com, co.uk, com.au, ru, ...
GTTS_VOICE=com

# --- Logging ---
LOG_FILE=logs/bot_service.log
LOG_FILE_LEVEL=WARNING
ENABLE_JSON_LOGS=false
ENABLE_LOG_ROTATION=true

# --- Sentry (optional) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=bot_service@0.03
SENTRY_DEBUG=false

# --- Testing / local toggles ---
TESTING=false

# --- Bot token auto-bootstrap ---
BOT_TOKEN_AUTO_BOOTSTRAP_ENABLED=true
BOT_TOKEN_AUTO_BOOTSTRAP_ADMIN_ONLY=true
BOT_TOKEN_AUTO_BOOTSTRAP_REQUIRE_REFRESH_TOKEN=false
