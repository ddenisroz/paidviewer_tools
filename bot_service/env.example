# ========================================
# TTS_TTV Bot Service - РЕАЛЬНАЯ КОНФИГУРАЦИЯ
# ========================================

# ========================================
# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ
# ========================================

# ========================================
# TWITCH API (получить на https://dev.twitch.tv/console/apps)
# ========================================
TWITCH_CLIENT_ID=your_twitch_client_id          # Client ID из Twitch Dev Console
TWITCH_CLIENT_SECRET=your_twitch_client_secret  # Client Secret из Twitch Dev Console
TWITCH_BOT_TOKEN=oauth:your_bot_token_here      # Токен бота (начинается с oauth:)

# ========================================
# VK LIVE API (получить на https://dev.live.vkvideo.ru/)
# ========================================
VK_CLIENT_ID=your_vk_client_id                  # VK App ID из VK Dev Console
VK_CLIENT_SECRET=your_vk_client_secret          # VK App Secret из VK Dev Console
VK_REDIRECT_URI=http://localhost:8000/auth/vk/callback  # Redirect URI для OAuth
VK_AUTH_BASE_URL=https://auth.live.vkvideo.ru/app/oauth2/authorize # Auth URL для VK Live

# VK Live User Token для гостевого режима (обычный пользовательский токен)
VK_LIVE_USER_TOKEN=your_vk_live_user_access_token_here  # Токен аккаунта для "бота"

# Примечание: каналы подключаются динамически через дашборд после авторизации

# TTS Service URL (ваш ПК)
TTS_SERVICE_URL=http://localhost:8001           # URL TTS сервиса на вашем ПК

# ========================================
# YOUTUBE API (получить на https://console.cloud.google.com/)
# ========================================
YOUTUBE_API_KEY=your_youtube_api_key_here       # YouTube Data API v3 ключ

# ========================================
# DONATIONALERTS API (получить на https://www.donationalerts.com/api/oauth)
# ========================================
DONATIONALERTS_CLIENT_ID=your_donationalerts_client_id_here     # Client ID из DonationAlerts
DONATIONALERTS_CLIENT_SECRET=your_donationalerts_client_secret_here  # Client Secret из DonationAlerts

# JWT Secret (сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your_super_secret_jwt_key_here       # Секретный ключ для JWT (32+ символов)

# Admin Users (через запятую, без пробелов)
ADMIN_USERS=yourchy,payedviewer     # Список админов (username в Twitch)

# ========================================
# НАСТРОЙКИ ЛОГИРОВАНИЯ И БЭКАПОВ
# ========================================
LOG_LEVEL=INFO                       # Уровень логирования: DEBUG, INFO, WARNING, ERROR
TTS_LOG_LEVEL=INFO                   # Уровень логирования TTS сервиса

# ========================================
# ИНСТРУКЦИИ ПО НАСТРОЙКЕ
# ========================================
# 1. Скопируйте этот файл в .env
# 2. Заполните все обязательные настройки
# 3. Для VK Live:
#    - Создайте приложение на https://vk.com/apps?act=manage
#    - Выберите тип "Веб-сайт"
#    - Добавьте redirect URI: http://localhost:8000/auth/vk/callback
# 4. Для Twitch:
#    - Создайте приложение на https://dev.twitch.tv/console/apps
#    - Получите токен бота на https://twitchapps.com/tmi/
# 5. Для YouTube:
#    - Создайте проект на https://console.cloud.google.com/
#    - Включите YouTube Data API v3
#    - Создайте API ключ
#    - Добавьте ключ в YOUTUBE_API_KEY
# 6. Для DonationAlerts:
#    - Зарегистрируйтесь на https://www.donationalerts.com/
#    - Перейдите в https://www.donationalerts.com/api/oauth
#    - Создайте приложение
#    - Добавьте Client ID и Client Secret в соответствующие переменные
# 7. Перезапустите сервер после изменения настроек
