# Bot Service - Конфигурация
# Получить ключи: https://dev.twitch.tv, https://vk.com/apps

# === СЕРВЕР ===
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# === БЕЗОПАСНОСТЬ ===
# Секретный ключ для JWT (любая случайная строка 32+ символов)
SECRET_KEY=your-32-character-secret-key-here
ALGORITHM=HS256

# Ключ шифрования токенов (генерация ниже)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-44-character-encryption-key-here

# === URL (оставьте как есть для локальной разработки) ===
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
TTS_SERVICE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === БАЗА ДАННЫХ (SQLite, автоматически создается) ===
DATABASE_URL=sqlite:///./data/app_data.db

# Лимиты сообщений в БД (для всех каналов)
# Максимум сообщений на одного пользователя (владельца канала)
CHAT_MESSAGES_DB_LIMIT_PER_USER=3000
# Максимум сообщений в БД всего (для всех пользователей)
CHAT_MESSAGES_DB_LIMIT_TOTAL=100000
# Сколько дней хранить сообщения (старые удаляются)
CHAT_MESSAGES_RETENTION_DAYS=30

# === TWITCH (обязательно для Twitch интеграции) ===
# Получить: https://dev.twitch.tv/console/apps
# ВАЖНО: Redirect URL должен быть http://localhost:8000/auth/twitch/callback (или ваш BACKEND_URL)
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
TWITCH_BOT_TOKEN=your-twitch-bot-token

# === VK LIVE (обязательно для VK Live интеграции) ===
# Получить: https://vk.com/apps?act=manage
VK_CLIENT_ID=your-vk-client-id
VK_CLIENT_SECRET=your-vk-client-secret
VK_LIVE_USER_TOKEN=your-vk-live-token

# === YOUTUBE (для заказов YouTube видео) ===
# Получить: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key-here

# === DONATIONALERTS (для интеграции донатов) ===
# Получить: https://www.donationalerts.com/application/clients
# ВАЖНО: Redirect URI должен совпадать с BACKEND_URL + /auth/donationalerts/callback
DONATIONALERTS_CLIENT_ID=your-donationalerts-client-id
DONATIONALERTS_CLIENT_SECRET=your-donationalerts-client-secret
DONATIONALERTS_REDIRECT_URI=http://localhost:8000/auth/donationalerts/callback

# === HUGGINGFACE (для анализа психологии, опционально) ===
# Получить: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your-huggingface-token-here

# === ТЕСТИРОВАНИЕ (только для разработчиков) ===
TESTING=false