# ===================================
# BOT SERVICE - DEVELOPMENT CONFIGURATION
# ===================================
# Для production используйте env.production.example
# Для генерации ключей: python -c "import secrets; print(secrets.token_urlsafe(32))"

# === ОСНОВНЫЕ НАСТРОЙКИ ===
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# === СЕКРЕТНЫЕ КЛЮЧИ ===
# КРИТИЧНО: В production ОБЯЗАТЕЛЬНО измените!
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256

# === URL НАСТРОЙКИ ===
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
TTS_SERVICE_URL=http://localhost:8001

# === DATABASE ===
DATABASE_URL=sqlite:///./core/data/app_data.db

# === REDIS (опционально для development) ===
# REDIS_URL=redis://localhost:6379/0

# === RATE LIMITING ===
RATE_LIMIT_ENABLED=false  # Отключено для dev
MAX_REQUESTS_PER_MINUTE=1000
MAX_LOGIN_ATTEMPTS=10

# === TWITCH API ===
# Получить на https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_BOT_TOKEN=oauth:your_bot_token_here
TWITCH_REDIRECT_URI=http://localhost:8000/auth/twitch/callback

# === VK LIVE API ===
# Получить на https://dev.live.vkvideo.ru/
VK_CLIENT_ID=your_vk_client_id
VK_CLIENT_SECRET=your_vk_client_secret
VK_REDIRECT_URI=http://localhost:8000/auth/vk/callback
VK_AUTH_BASE_URL=https://auth.live.vkvideo.ru/app/oauth2/authorize
VK_LIVE_USER_TOKEN=your_vk_live_user_token

# === YOUTUBE API ===
# Получить на https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key

# === DONATION ALERTS ===
# Получить на https://www.donationalerts.com/api/oauth
DONATIONALERTS_CLIENT_ID=your_donationalerts_client_id
DONATIONALERTS_CLIENT_SECRET=your_donationalerts_client_secret
DONATIONALERTS_REDIRECT_URI=http://localhost:8000/auth/da/callback

# === HUGGING FACE ===
# Получить на https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token
HF_HOME=./f5_tts_cache
HUGGINGFACE_HUB_CACHE=./f5_tts_cache

# === CORS НАСТРОЙКИ ===
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# === ADMIN НАСТРОЙКИ ===
# Список админов через запятую (Platform User IDs)
# Формат: platform:user_id,platform:user_id
# Пример: twitch:987654321,vk:20416992
ADMIN_USERS=twitch:987654321,vk:20416992

# === ЛОГИРОВАНИЕ ===
LOG_LEVEL=DEBUG
LOG_DIR=./logs
ENABLE_JSON_LOGS=false  # true для production
ENABLE_LOG_ROTATION=true

# === SESSION ===
SESSION_TIMEOUT_DAYS=30
SESSION_COOKIE_SECURE=false  # true для production с HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# ========================================
# ИНСТРУКЦИИ ПО НАСТРОЙКЕ
# ========================================
# 1. Скопируйте этот файл в .env
# 2. Заполните все обязательные настройки
# 3. Для VK Live:
#    - Создайте приложение на https://vk.com/apps?act=manage
#    - Выберите тип "Веб-сайт"
#    - Добавьте redirect URI: http://localhost:8000/auth/vk/callback
# 4. Для Twitch:
#    - Создайте приложение на https://dev.twitch.tv/console/apps
#    - Получите токен бота на https://twitchapps.com/tmi/
# 5. Для YouTube:
#    - Создайте проект на https://console.cloud.google.com/
#    - Включите YouTube Data API v3
#    - Создайте API ключ
#    - Добавьте ключ в YOUTUBE_API_KEY
# 6. Для DonationAlerts:
#    - Зарегистрируйтесь на https://www.donationalerts.com/
#    - Перейдите в https://www.donationalerts.com/api/oauth
#    - Создайте приложение
#    - Добавьте Client ID и Client Secret в соответствующие переменные
# 7. Для Hugging Face (анализ эмоций):
#    - Зарегистрируйтесь на https://huggingface.co/
#    - Перейдите в https://huggingface.co/settings/tokens
#    - Создайте новый токен с правами "Read"
#    - Скопируйте токен (начинается с hf_)
#    - Добавьте токен в HUGGINGFACE_API_TOKEN
# 8. Перезапустите сервер после изменения настроек
