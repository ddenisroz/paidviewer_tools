ponents.StreamStartInput":{"title":"Начало трансляции (будет видно до запуска)","noTime":"Сейчас"},"@streams/desktop/components.StreamSlots.components.StreamForm.components.VkLinkCheckbox":{"label":"Опубликовать пост с трансляцией на стене сообщества ВКонтакте","description":{"header":"В сообществе появится пост с трансляцией и её описанием.","text":"Для постоянных трансляций пост создаётся при запуске каждой новой трансляции.","footer":"Для одноразовой трансляции пост публикуется при её создании. Если внести изменения до начала эфира, описание в посте обновится."}},"@streams/desktop/components.StreamSlots.components.StreamForm.components.VkLinkInput":{"label":"Ссылка на пост в сообществе ВКонтакте","copySuccess":"Ссылка на пост успешно скопирована"},"@streams/desktop/components.StreamSlots.components.StreamForm.hooks":{"error":{"default":"Произошла ошибка","titleTooLong":"Превышено количество символов","invalidParam":"Неверные параметры запроса"},"form":{"titleRequired":"Поле должно быть заполнено","titleMinLength":"Название должно быть не менее 3-х символов","categoryRequired":"Для трансляции нужна категория"},"streamUrlLabel":"Ссылка для подключения трансляции","streamUrl":{"copySuccess":"URL трансляции успешно скопирован"},"streamKey":{"resetSuccess":"Ключ трансляции успешно сброшен","copySuccess":"Ключ трансляции успешно скопирован"},"type":{"temporary":"Одноразовая","constant":"Постоянная"},"success":"Настройки успешно сохранены"},"@streams/desktop/components.SupportProgram.ActiveSeasonCountdown":{"timeLeft":"До завершения сезона осталось","days":"дней","hours":"часов","minutes":"минут"},"@streams/desktop/components.SupportProgram.Clarification":{"title":"Разъяснения","clarification":{"0":"1. Если одновременно (i) стример достиг всех указанных выше целей для какого-либо уровня в течение сезона; и (ii) на соответствующем уровне на момент достижения целей есть свободные «Места на уровне», то стример считается достигнувшим этого уровня в этом сезоне.","1":"2. Если стример достиг целей одного уровня, а потом следующего, то награда выдается только за последний достигнутый стримером уровень на момент окончания Сезона.","2":"3. Во всем, что не указано на этой странице, программа поддержки стримеров &lt;ProjectName&gt; &lt;/ProjectName&gt; регулируется &lt;Link&gt;условиями&lt;/Link&gt; проведения Конкурса. В случае противоречий преимущественную силу имеют условия, указанные на этой странице.","3":"4. Условия, указанные на этой странице, могут быть изменены в одностороннем порядке без предварительного уведомления стримеров. Любые изменения вступают в силу с момента опубликования на этой странице, если иное не указано в новой опубликованной версии.","4":"5. Денежные награды смогут получить только самозанятые. Если юридически вы не можете стать самозанятым – вам необходимо обратиться в &lt;Link&gt;поддержку&lt;/Link&gt;, описав вашу ситуацию – мы найдем решение.","5":"6. Метрики участников Программы поддержки учитываются только от просмотров трансляций участников на сайте и приложениях &lt;ProjectName&gt; &lt;/ProjectName&gt;. Просмотры на других сайтах и встроенных плеерах не идут в зачет и не учитываются в счетчике зрителей."},"byOffer":"офертой"},"@streams/desktop/components.SupportProgram.FeedbackAlert":{"winnersProfile":"Анкета победителя","rewardPrecondition":"Для получения награды за сезон &lt;Br&gt; &lt;/Br&gt; заполните анкету победителя","fillOut":"Заполнить"},"@streams/desktop/components.SupportProgram.FinishedSeason":{"seasonFinished":"Сезон завершен!","congrats":"Поздравляем, вы достигли {{level}}!","monetaryReward":"Денежный приз будет выплачен в течение двух недель","level":{"basic":"базового уровня","level1":"уровня 1","level2":"уровня 2","level3":"уровня 3","level4":"уровня 4","level5":"уровня 5","level6":"уровня 6"},"noLevel":"В этом сезоне вы не заняли призовое место, &lt;Br&gt; &lt;/Br&gt;ждем вас в следующем!","notParticipate":"Вы не приняли участие в этом сезоне, &lt;Br&gt; &lt;/Br&gt;ждем вас в следующем!"},