vel":"нет уровня","nominative":{"level1":"уровень 1","level2":"уровень 2","level3":"уровень 3","level4":"уровень 4","level5":"уровень 5","level6":"уровень 6","toCut":"уровень"},"genitive":{"level1":"уровня 1","level2":"уровня 2","level3":"уровня 3","level4":"уровня 4","level5":"уровня 5","level6":"уровня 6","toCut":"уровня"}},"@streams/desktop/components.RatingProgram.LevelProgress":{"title":"До уровня","maxLevelReached":"Достигнут &lt;MaxLevelName&gt; &lt;/MaxLevelName&gt;"},"@streams/desktop/components.RatingProgram.MetricDescription":{"days_on_air":"Количество дней, в которые вы проводили трансляции дольше двух часов","raid_members":"Количество зрителей, которых вы отправили рейдами на другие каналы","view_time":"Время, которое зрители провели за просмотром ваших трансляций","cp_reward_activate":"Количество баллов, которое зрители потратили на «награды» вашего канала","total_profit":"Максимальная стоимость одновременно активных платных подписок на ваш канал за сезон","like":"Количество сердец, оставленных зрителями на ваших трансляциях","verification":"Верификация канала"},"@streams/desktop/components.RatingProgram.MetricName":{"days_on_air":"дней &lt;Br&gt; &lt;/Br&gt; трансляций","raid_members":"рейдеры","view_time":"минут &lt;Br&gt; &lt;/Br&gt; просмотра","cp_reward_activate":"потраченные &lt;Br&gt; &lt;/Br&gt; баллы","total_profit":"заработок","like":"сердца","verification":"Верификация канала"},"@streams/desktop/components.RatingProgram.MetricValue":{"days_on_air":{"0":"день","1":"дня","2":"дней"},"view_time":"мин."},"@streams/desktop/components.RatingProgram.RulesClarification":{"title":"Разъяснения","clarification":{"0":"1. Если стример достиг целей одного уровня, а потом следующего, то награда выдается только за последний достигнутый стримером уровень на момент окончания Сезона.","1":"2. Условия, указанные на этой странице, могут быть изменены в одностороннем порядке без предварительного уведомления стримеров. Любые изменения вступают в силу с момента опубликования на этой странице, если иное не указано в новой опубликованной версии.","2":"3. Метрики участников Программы поддержки учитываются только от просмотров трансляций участников на сайте и приложениях {{projectName}}. Просмотры на других сайтах и встроенных плеерах не идут в зачет и не учитываются в счетчике зрителей."}},"@streams/desktop/components.RatingProgram.RulesTerms":{"title":"Термины","metricDescription":{"days_on_air":{"header":"Количество дней в течение сезона, в которые была проведена трансляция.","rules":{"0":"День трансляции засчитывается, если суммарная длительность трансляций, начатых в этот день, была не менее 2 часов.","1":"Отсчет дня в течение сезона начинается в 03:00 по московскому времени и заканчивается через 24 часа."}},"raid_members":{"header":"Сумма всех зрителей, отправленных Стримером рейдами с использованием функционала Сервиса на другие каналы в течение сезона.","rules":{"0":"В один день засчитывается только один рейд с максимальным количеством «Рейдеров»","1":"Отсчет дня в течение сезона начинается в 03:00 по московскому времени и заканчивается через 24 часа."}},"view_time":{"header":"Сумма минут, в течение которых каждый из зрителей смотрел Трансляцию.","rules":{"0":"В показатель учитывается только время просмотра тех зрителей, которые смотрели трансляцию больше 1 секунды","1":"Например, 10 зрителей, просмотревших Трансляцию по 6 секунд, добавляют 1 минуту в показатель «Минут просмотра»."}},"total_profit":{"lines":{"0":"Максимальная общая сумма платных подписок &lt;BoostyLink&gt;Boosty.to&lt;/BoostyLink&gt; в отношении канала стримера на {{projectName}} в течение сезона.","1":"Рассчитывается как сумма «Стоимостей» всех активных подписок в конкретный день.","2":"&lt;Br&gt; &lt;/Br&gt;","3":"Что влияет на метрику:","4":"&lt;Li&gt;новая подписка от нового подписчика (добавит стоимость этой подписки только за 1 месяц, вне зависимости от срока подписки)&lt;/Li&gt;","5":"&lt;Li&gt;повышение уровня подписки текущего подписчика (заменит стоимость текущей подписки)&lt;/Li&gt;","6":"&lt;Li&gt;принятая получателем подарочная подписка (добавит стоимость за 1 месяц, вне зависимости от срока подписки)&lt;/Li&gt;","7":"&lt;Br&gt; &lt;/Br&gt;","8":"Что не влияет на метрику:","9":"&lt;Li&gt;плановое продление существующей подписки (общая стоимость купленных подписок от этого не меняется)&lt;/Li&gt;","10":"&lt;Li&gt;понижение уровня подписки (зачтется только после окончания срока текущего уровня)&lt;/Li&gt;","11":"&lt;Li&gt;купленная подарочная подписка (зачтется только после принятия получателем)&lt;/Li&gt;","12":"&lt;Li&gt;донаты&lt;/Li&gt;"}},"cp_reward_activate":{"lines":{"0":"Количество баллов, потраченных зрителями Трансляций Стримера на «награды» канала такого Стримера через функционал Платформы в течение Сезона.","1":"Запросы наград должны быть выполнены стримером."}},"like":"Суммарное количество сердец, поставленных на Трансляциях.","verification":{"lines":{"0":"&lt;Li&gt;Впервые получить галку верификации можно, достигнув 3 уровня и выше в Стримерском сезоне.&lt;/Li&gt;","1":"&lt;Li&gt;Достигнув 3 уровня и выше, Стример получает право подать заявку на верификацию канала и, при одобрении, получить галку соответствующего уровня.&lt;/Li&gt;","2":"&lt;Br&gt; &lt;/Br&gt;","3":"Обновление Галок:","4":"&lt;Li&gt;Если стример уже верифицирован, в последующих Стримерских сезонах цвет галки будет изменяться в зависимости от достигнутого уровня в последнем сезоне.&lt;/Li&gt;","5":"&lt;Br&gt; &lt;/Br&gt;","6":"Преимущества:","7":"&lt;Li&gt;Отображение у канала галки верификации соответствующего уровня.&lt;/Li&gt;","8":"&lt;Li&gt;Возможность размещения канала в Карусели на главной странице {{projectName}}. Чем выше текущий уровень, тем чаще канал будет размещаться в Карусели.&lt;/Li&gt;"}}}},"@streams/desktop/components.RatingProgram.SeasonInfo":{"rules":"Правила участия"},"@streams/desktop/components.RatingProgram.SeasonLevelBadge":{"verifiedChannelLevel":{"0":"Верифицированный канал | Уровень 1","1":"Верифиц