ponents.StreamStartInput":{"title":"Начало трансляции (будет видно до запуска)","noTime":"Сейчас"},"@streams/desktop/components.StreamSlots.components.StreamForm.components.VkLinkCheckbox":{"label":"Опубликовать пост с трансляцией на стене сообщества ВКонтакте","description":{"header":"В сообществе появится пост с трансляцией и её описанием.","text":"Для постоянных трансляций пост создаётся при запуске каждой новой трансляции.","footer":"Для одноразовой трансляции пост публикуется при её создании. Если внести изменения до начала эфира, описание в посте обновится."}},"@streams/desktop/components.StreamSlots.components.StreamForm.components.VkLinkInput":{"label":"Ссылка на пост в сообществе ВКонтакте","copySuccess":"Ссылка на пост успешно скопирована"},"@streams/desktop/components.StreamSlots.components.StreamForm.hooks":{"error":{"default":"Произошла ошибка","titleTooLong":"Превышено количество символов","invalidParam":"Неверные параметры запроса"},"form":{"titleRequired":"Поле должно быть заполнено","titleMinLength":"Название должно быть не менее 3-х символов","categoryRequired":"Для трансляции нужна категория"},"streamUrlLabel":"Ссылка для подключения трансляции","streamUrl":{"copySuccess":"URL трансляции успешно скопирован"},"streamKey":{"resetSuccess":"Ключ трансляции успешно сброшен","copySuccess":"Ключ трансляции успешно скопирован"},"type":{"temporary":"Одноразовая","constant":"Постоянная"},"success":"Настройки успешно сохранены"},"@streams/desktop/components.SupportProgram.ActiveSeasonCountdown":{"timeLeft":"До завершения сезона осталось","days":"дней","hours":"часов","minutes":"минут"},"@streams/desktop/components.SupportProgram.Clarification":{"title":"Разъяснения","clarification":{"0":"1. Если одновременно (i) стример достиг всех указанных выше целей для какого-либо уровня в течение сезона; и (ii) на соответствующем уровне на момент достижения целей есть свободные «Места на уровне», то стример считается достигнувшим этого уровня в этом сезоне.","1":"2. Если стример достиг целей одного уровня, а потом следующего, то награда выдается только за последний достигнутый стримером уровень на момент окончания Сезона.","2":"3. Во всем, что не указано на этой странице, программа поддержки стримеров &lt;ProjectName&gt; &lt;/ProjectName&gt; регулируется &lt;Link&gt;условиями&lt;/Link&gt; проведения Конкурса. В случае противоречий преимущественную силу имеют условия, указанные на этой странице.","3":"4. Условия, указанные на этой странице, могут быть изменены в одностороннем порядке без предварительного уведомления стримеров. Любые изменения вступают в силу с момента опубликования на этой странице, если иное не указано в новой опубликованной версии.","4":"5. Денежные награды смогут получить только самозанятые. Если юридически вы не можете стать самозанятым – вам необходимо обратиться в &lt;Link&gt;поддержку&lt;/Link&gt;, описав вашу ситуацию – мы найдем решение.","5":"6. Метрики участников Программы поддержки учитываются только от просмотров трансляций участников на сайте и приложениях &lt;ProjectName&gt; &lt;/ProjectName&gt;. Просмотры на других сайтах и встроенных плеерах не идут в зачет и не учитываются в счетчике зрителей."},"byOffer":"офертой"},"@streams/desktop/components.SupportProgram.FeedbackAlert":{"winnersProfile":"Анкета победителя","rewardPrecondition":"Для получения награды за сезон &lt;Br&gt; &lt;/Br&gt; заполните анкету победителя","fillOut":"Заполнить"},"@streams/desktop/components.SupportProgram.FinishedSeason":{"seasonFinished":"Сезон завершен!","congrats":"Поздравляем, вы достигли {{level}}!","monetaryReward":"Денежный приз будет выплачен в течение двух недель","level":{"basic":"базового уровня","level1":"уровня 1","level2":"уровня 2","level3":"уровня 3","level4":"уровня 4","level5":"уровня 5","level6":"уровня 6"},"noLevel":"В этом сезоне вы не заняли призовое место, &lt;Br&gt; &lt;/Br&gt;ждем вас в следующем!","notParticipate":"Вы не приняли участие в этом сезоне, &lt;Br&gt; &lt;/Br&gt;ждем вас в следующем!"},"@streams/desktop/components.SupportProgram.HowToJoin":{"howToJoin":"Как участвовать?","aboutLevelsAndRewards":"Об уровнях и наградах","details":"Подробнее","disclaimer":"Бета-версия, возможны изменения &lt;Br&gt; &lt;/Br&gt; в правилах и условиях участия"},"@streams/desktop/components.SupportProgram.LevelName":{"noLevel":"нет уровня","nominative":{"basic":"базовый уровень","level1":"уровень 1","level2":"уровень 2","level3":"уровень 3","level4":"уровень 4","level5":"уровень 5","level6":"уровень 6","toCut":"уровень"},"genitive":{"basic":"базового уровня","level1":"уровня 1","level2":"уровня 2","level3":"уровня 3","level4":"уровня 4","level5":"уровня 5","level6":"уровня 6","toCut":"уровня"}},"@streams/desktop/components.SupportProgram.LevelProgress":{"title":"До уровня","maxLevelReached":"Достигнут &lt;MaxLevelName&gt; &lt;/MaxLevelName&gt;"},"@streams/desktop/components.SupportProgram.MetricName":{"days_on_air":"дней &lt;Br&gt; &lt;/Br&gt; трансляций","best_days_on_air":"Лучшие Дни трансляции","raid_members":"рейдеры","stream_time":"время &lt;Br&gt; &lt;/Br&gt; в эфире","view_time":"минут &lt;Br&gt; &lt;/Br&gt; просмотра","average_viewer_count":"средний &lt;Br&gt; &lt;/Br&gt; онлайн","cp_reward_activate":"потраченные &lt;Br&gt; &lt;/Br&gt; баллы","total_profit":"заработок","like":"сердца","prize":"награда","vk_gifts":"Подарки от VK","payout":"Выплата","payout_status":"Статус выплаты"},"@streams/desktop/components.SupportProgram.MetricValue":{"stream_time":"мин."},"@streams/desktop/components.SupportProgram.PaymentInfo":{"title":"Подключить выплаты","checkingTitle":"В процессе проверки статуса самозанятого","okTitle":"Вы самозанятый","errorTitle":"Ошибка проверки","subTitle":"Для получения денежных наград","okSubTitle":"Скоро вы сможете привязать карту","okCardAvailableSubtitle":"Осталось привязать карту","errorSubTitle":"Получите статус самозанятого","link":"Подключить","details":"Подробнее","okCardAvailableDetails":"Добавить карту","disclaimer":"Узнайте подробнее как подключить выплаты","processingDisclaimer":"Это необходимо, чтобы иметь возможность получать выплату","withCardsOkTitle":"Выплаты подключены","withManyCardsOkSubtitle":"Карта: {{cardMask}} и еще {{cardsCountLeft}}","withSingleCardOkSubtitle":"Карта: {{cardMask}}","withCardsOkDisclaimer":"После завершения сезона и проверки вы сможете забрать награду","bindingProcess":"Идет обновление списка привязанных карт","retry":"Повторить попытку","payout":{"waitApproval":"Идет подведение итогов сезона и проверка нашими юристами","takeReward":"Забрать награду","rejected":"Проверка ППС не пройдена &lt;Br&gt; &lt;/Br&gt;&lt;Link&gt;обратитесь в поддержку&lt;/Link&gt;","processing":"Отправлена заявка &lt;Br&gt; &lt;/Br&gt;на выплату","payError":"Ошибка получения выплаты  &lt;Br&gt; &lt;/Br&gt;&lt;Link&gt;обратитесь в поддержку&lt;/Link&gt;","paid":"Все выплаты получены. &lt;Br&gt; &lt;/Br&gt;Ждите новый сезон!"}},"@streams/desktop/components.SupportProgram.PayoutStatus":{"check":"Проверка","processing":"В процессе","rejected":"Отклонено","take":"Забрать","error":"Ошибка","received":"Получена"},"@streams/desktop/components.SupportProgram.PayoutWarning":{"setPayout":"Для получения денежного приза подключите выплаты в окне выше"},"@streams/desktop/components.SupportProgram.PlannedSeason":{"beforeNextSeason":"До начала следующего сезона"},"@streams/desktop/components.SupportProgram.RulesLevels":{"title":"Цели уровней Программы поддержки"},"@streams/desktop/components.SupportProgram.RulesTerms":{"title":"Термины","metricDescription":{"best_days_on_air":"Дни трансляции с наибольшим Средним онлайном в течение Сезона.","days_on_air":{"header":"Количество дней в течение сезона, в которые была проведена трансляция.","rules":{"0":"День трансляции засчитывается, если суммарная длительность трансляций, начатых в этот день, была не менее 2 часов.","1":"Отсчет дня в течение сезона начинается в 03:00 по московскому времени и заканчивается через 24 часа."}},"raid_members":{"header":"Сумма всех зрителей, отправленных рейдами на другие каналы в течение сезона.","rules":{"0":"В один день засчитывается только один рейд с максимальным количеством \"Рейдеров\"","1":"Отсчет дня в течение сезона начинается в 03:00 по московскому времени и заканчивается через 24 часа."}},"stream_time":"Суммарная длительность Трансляций в течение сезона.","view_time":{"header":"Сумма секунд, в течение которых каждый из зрителей смотрел Трансляцию.","rules":{"0":"Во времени просмотра учитываются только Секунды просмотра тех зрителей, которые смотрели трансляцию больше 1 секунды.","1":"Например, 10 зрителей, просмотревших Трансляцию по 6 секунд, добавляют 1 минуту в показатель «Минут просмотра»."}},"average_viewer_count":{"header":"Среднее количество людей*, единовременно просматривающих Трансляции конкретного стримера.","lines":{"0":"Средний онлайн рассчитывается по формуле «средний онлайн Лучших Дней Трансляций/количество Лучших Дней Трансляций», при этом: (1) учитывается средний онлайн и количество только стольких Лучших Дней трансляций, сколько требуется Дней Трансляций для конкретного уровня. Например, для уровня с 6 Днями трансляции будут учитываться только 6 Лучших Дней трансляции.","1":"*При расчете Среднего онлайна не учитываются просмотры, выполняемые с помощью автоматизированных инструментов или являющиеся результатом любой ошибки или мошеннической деятельности."}},"total_profit":{"lines":{"0":"Максимальная общая сумма платных подписок &lt;BoostyLink&gt;Boosty.to&lt;/BoostyLink&gt; в отношении канала стримера на {{projectName}} в течение сезона.","1":"Рассчитывается как сумма «Стоимостей» всех активных подписок в конкретный день.","2":"&lt;Br&gt; &lt;/Br&gt;","3":"Что влияет на метрику:","4":"&lt;Li&gt;новая подписка от нового подписчика (добавит стоимость этой подписки только за 1 месяц, вне зависимости от срока подписки)&lt;/Li&gt;","5":"&lt;Li&gt;повышение уровня подписки текущего подписчика (заменит стоимость текущей подписки)&lt;/Li&gt;","6":"&lt;Li&gt;активированная подарочная подписка (добавит стоимость за 1 месяц, вне зависимости от срока подписки)&lt;/Li&gt;","7":"&lt;Br&gt; &lt;/Br&gt;","8":"Что не влияет на метрику:","9":"&lt;Li&gt;подписки от учетных записей Boosty.to, которые не привязаны к профилю на {{projectName}}&lt;/Li&gt;","10":"&lt;Li&gt;плановое продление существующей подписки (общая стоимость купленных подписок от этого не меняется)&lt;/Li&gt;","11":"&lt;Li&gt;понижение уровня подписки&lt;/Li&gt;","12":"&lt;Li&gt;купленная подарочная подписка (зачтется только после активации)&lt;/Li&gt;","13":"&lt;Li&gt;донаты&lt;/Li&gt;"}},"cp_reward_activate":{"rules":{"0":"Количество баллов, потраченных зрителями Трансляций Стримера на «награды» канала такого Стримера через функционал Платформы в течение Сезона.&lt;Br&gt; &lt;/Br&gt;Запросы наград должны быть выполнены стримером."}},"like":"Суммарное количество сердец, поставленных на Трансляциях.","vk_gifts":{"lines":{"0":"Лучший стример каждого уровня по минутам просмотра получит специальный Приз от VK - Оформление места стримера: Неоновая вывеска, умная колонка «Маруся», 3 умные лампочки, брендированный пончо, напольный осветительный прибор, брендированный коврик для мышки, сопровождающие дизайн элементы (3 штуки)."}}},"slots":{"name":"Мест на уровне","description":{"header":"Количество стримеров, которое может получить Награду такого уровня при условии достижения целей такого уровня в течение сезона.","rules":{"0":"Текущее свободное количество мест на каждом уровне указано до разделительного знака «/».","1":"Например, «0/15» означает, что все места на уровне заняты, но стример может достигать целей следующего уровня, чтобы попасть на следующий уровень с незанятыми местами."}}},"prize":{"name":"Награда","description":{"header":"Условия выплаты вознаграждения за Трансляции. Вознаграждение выплачивается за достижение стримером целей уровней в течение сезона при соблюдении следующих условий:","rules":{"0":"Вознаграждение может быть получено только за уровень, целей которого стример достиг на момент окончания сезона.","1":"Денежное вознаграждение ограничено местами на уровне и выплачивается только в случае, если стример достиг целей уровня и смог занять «место на уровне» в течение сезона среди первых N стримеров, достигших целей уровня, где N – общее количество мест на таком уровне.","2":"Награда в виде слотов смайлов и ролей выдается за достижение целей уровня, даже если места на уровне закончились. Слоты смайлов и ролей разблокируются после окончания сезона в количестве, указанном в наградах достигнутого уровня, через сутки после завершения сезона."}}},"season":{"name":"Сезон","description":"Период с {{dateStart}} г. по {{dateEnd}} г. по московскому времени."},"broadcast":{"name":"Трансляция","description":"Видеотрансляции (стримы), проведенные пользователем (стримером) на платформе {{projectName}} в течение зачтенных «Дней трансляции» в течение Сезона. Трансляции, проведенные в дни, не учтенные как «Дни трансляций», не учитываются в определении «Трансляций»."},"targets":{"name":"Цели уровней","description":"Условия, выполнение (соблюдение) которых является основанием для предоставления стримеру соответствующей награды, включая (когда применимо) выплату денежного вознаграждения. Достижение уровня (целей уровня) = выполнение условий для предоставления награды."}},"@streams/desktop/components.SupportProgram.SeasonStatistics":{"title":"Статистика сезона","statRecording":"Учет статистики с"},"@streams/desktop/components.SupportProgram.SeasonsHistory":{"archive":"Архив ППС","history":"История","level":"Уровень","payoutStatus":"Статус выплаты"},"@streams/desktop/components.SupportProgram.StayTuned":{"newSeasonIsStartingSoon":"Скоро начало &lt;Br&gt; &lt;/Br&gt; следующего сезона!","stayTuned":"Следите за новостями!"},"@streams/desktop/components.SupportProgram.SeasonLevel.components.SeasonLevelConditions":{"slots":"места на уровне","unlimited":"Неограниченно"},"@streams/desktop/components.SupportProgram.SeasonLevel.components.SeasonLevelQueued