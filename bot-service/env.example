# ========================================
# TTS_TTV Bot Service - РЕАЛЬНАЯ КОНФИГУРАЦИЯ
# ========================================

# ========================================
# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ
# ========================================

# ========================================
# TWITCH API (получить на https://dev.twitch.tv/console/apps)
# ========================================
TWITCH_CLIENT_ID=your_twitch_client_id          # Client ID из Twitch Dev Console
TWITCH_CLIENT_SECRET=your_twitch_client_secret  # Client Secret из Twitch Dev Console
TWITCH_BOT_TOKEN=oauth:your_bot_token_here      # Токен бота (начинается с oauth:)

# ========================================
# VK LIVE API (получить на https://dev.live.vkvideo.ru/)
# ========================================
VK_CLIENT_ID=your_vk_client_id                  # VK App ID из VK Live Dev Console
VK_CLIENT_SECRET=your_vk_client_secret          # VK App Secret из VK Live Dev Console
VK_BOT_TOKEN=your_vk_bot_token                  # Токен VK бота

# Примечание: каналы подключаются динамически через дашборд после авторизации

# TTS Service URL (ваш ПК)
TTS_SERVICE_URL=http://localhost:8001           # URL TTS сервиса на вашем ПК

# JWT Secret (сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your_super_secret_jwt_key_here       # Секретный ключ для JWT (32+ символов)

# Admin Email (для отправки кодов доступа)
ADMIN_EMAIL_PASSWORD=your_gmail_app_password    # Пароль приложения Gmail для отправки кодов

# ========================================
# ОПЦИОНАЛЬНЫЕ НАСТРОЙКИ
# ========================================

# Server
HOST=0.0.0.0                    # IP адрес сервера (0.0.0.0 = все интерфейсы)
PORT=8000                       # Порт для Bot сервиса
DEBUG=false                     # Режим отладки (true/false)

# Bot
BOT_PREFIX=!                    # Префикс команд (!tts, !mute и т.д.)
MAX_MESSAGE_LENGTH=350          # Максимальная длина сообщения для TTS
MESSAGE_COOLDOWN=1              # Задержка между сообщениями (секунды)

# TTS
TTS_TIMEOUT=30                  # Таймаут запросов к TTS (секунды)
TTS_RETRY_ATTEMPTS=3            # Количество попыток при ошибке

# CORS (для фронтенда)
CORS_ORIGINS=http://localhost:5173  # Разрешенные домены для CORS

# Logging
LOG_LEVEL=INFO                  # Уровень логирования (DEBUG/INFO/WARNING/ERROR)
LOG_FILE=bot_service.log        # Файл логов (пустой = только консоль)
