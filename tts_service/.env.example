# ===============================================================================
# TTS SERVICE - ENVIRONMENT CONFIGURATION
# ===============================================================================
# Скопируйте этот файл в .env и заполните значениями

# === ОСНОВНЫЕ НАСТРОЙКИ ===
ENVIRONMENT=development          # development | production
TTS_DEBUG=true                   # true = подробные ошибки
TTS_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# === БЕЗОПАСНОСТЬ ===
# ВАЖНО: SECRET_KEY должен совпадать с bot_service!
SECRET_KEY=должен-совпадать-с-bot_service
ALGORITHM=HS256

# === СЕРВЕР ===
TTS_HOST=0.0.0.0                 # Хост (0.0.0.0 = все интерфейсы)
TTS_PORT=8001                    # Порт TTS сервиса
TTS_WORKERS=1                    # Кол-во воркеров (для прода увеличить)
BOT_SERVICE_URL=http://localhost:8000

# === БАЗА ДАННЫХ ===
# SQLite (для разработки): sqlite:///./data/tts_service.db
# PostgreSQL (для прода):  postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/tts_service.db

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# === TTS НАСТРОЙКИ ===
TTS_MAX_MESSAGE_LENGTH=500       # Макс длина сообщения
TTS_DEFAULT_VOICE=female_russian # Голос по умолчанию
TTS_CACHE_DIR=./audio/cache      # Папка кэша аудио
TTS_VOICES_DIR=./audio/voices    # Папка с голосами

# === АУДИО ===
AUDIO_SAMPLE_RATE=24000          # Частота дискретизации
AUDIO_FORMAT=wav                 # Формат: wav, mp3, ogg
AUDIO_BITRATE=192k
MAX_AUDIO_FILE_SIZE=10485760     # 10 MB макс

# === ПРОИЗВОДИТЕЛЬНОСТЬ ===
MAX_CONCURRENT_REQUESTS=5        # Одновременных запросов
TTS_GENERATION_TIMEOUT=30        # Таймаут генерации (сек)

# === ЛОГИРОВАНИЕ ===
LOG_DIR=./logs
ENABLE_LOG_ROTATION=true

# === БЭКАПЫ ===
ENABLE_AUTO_BACKUP=true          # Автобэкап
MAX_DB_BACKUPS=30                # Хранить N бэкапов БД
MAX_CONFIG_BACKUPS=7
MAX_LOGS_BACKUPS=7
MAX_AUDIO_BACKUPS=3
MAX_MODELS_BACKUPS=1

# === GPU (опционально) ===
# F5_TTS_MODEL_PATH=./models/f5_tts
# REDIS_URL=redis://localhost:6379/0
# GOOGLE_CLOUD_API_KEY=твой-google-api-key

# ===============================================================================
# PRODUCTION CHECKLIST:
# ===============================================================================
# ENVIRONMENT=production
# TTS_DEBUG=false
# TTS_LOG_LEVEL=WARNING
# TTS_WORKERS=4
