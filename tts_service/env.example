# tts_service/env.example
# ========================================
# TTS Service - Конфигурация
# ========================================

# ========================================
# НАСТРОЙКИ ЛОГИРОВАНИЯ И БЭКАПОВ
# ========================================
TTS_LOG_LEVEL=INFO                   # Уровень логирования: DEBUG, INFO, WARNING, ERROR

# ========================================
# НАСТРОЙКИ СЕРВИСА
# ========================================
TTS_HOST=0.0.0.0                    # Хост для запуска сервиса
TTS_PORT=8001                       # Порт для запуска сервиса
TTS_DEBUG=True                      # Режим отладки

# ========================================
# НАСТРОЙКИ CORS
# ========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================================
# НАСТРОЙКИ БЭКАПОВ
# ========================================
MAX_DB_BACKUPS=30                   # Дней хранения бэкапов БД
MAX_CONFIG_BACKUPS=7                 # Дней хранения бэкапов конфигурации
MAX_LOGS_BACKUPS=7                  # Дней хранения бэкапов логов
MAX_AUDIO_BACKUPS=3                 # Дней хранения бэкапов аудио
MAX_MODELS_BACKUPS=1                 # Дней хранения метаданных моделей

# ========================================
# ИНСТРУКЦИИ ПО НАСТРОЙКЕ
# ========================================
# 1. Скопируйте этот файл в .env
# 2. Настройте уровень логирования по необходимости
# 3. Перезапустите TTS сервис после изменения настроек
