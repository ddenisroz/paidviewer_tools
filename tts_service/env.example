# TTS Service (Полная версия с GPU Worker Pool + Redis)
# ⚠️ Для простой установки БЕЗ Redis используйте TTS F5 Simple!
# Документация: docs/LOCAL_TTS_SETUP.md

# === СЕРВЕР ===
# IP адрес для прослушивания (0.0.0.0 = все интерфейсы)
TTS_HOST=0.0.0.0
# Порт сервиса (8001 по умолчанию)
TTS_PORT=8001
# Уровень логирования (debug, info, warning, error)
TTS_LOG_LEVEL=info
LOG_LEVEL=INFO

# === БЕЗОПАСНОСТЬ ===
# Секретный ключ для JWT (любая случайная строка 32+ символов)
SECRET_KEY=your-32-character-secret-key-here
# Алгоритм шифрования JWT
ALGORITHM=HS256

# === TTS ЛИМИТЫ ===
# Максимальная длина текста для озвучки (символов)
TTS_MAX_TEXT_LENGTH=200
# Лимит запросов в день на пользователя
TTS_DAILY_LIMIT=100
# Максимальное время работы GPU на задачу (секунд)
TTS_GPU_TIME_LIMIT=300.0

# === REDIS (ОБЯЗАТЕЛЬНО!) ===
# Redis используется для очередей задач GPU Worker Pool
# Установка: https://redis.io/docs/getting-started/installation/
# Windows: https://github.com/microsoftarchive/redis/releases
REDIS_URL=redis://localhost:6379/0

# === GPU НАСТРОЙКИ ===
# Ограничить использование VRAM (в ГБ, 0 = использовать всю доступную)
GPU_MAX_VRAM_GB=0

# === GPU WORKER POOL (Redis Streams) ===
# URL Redis для GPU worker pool (обычно тот же что и основной)
GPU_REDIS_URL=redis://localhost:6379/0
# Названия потоков Redis для обмена задачами
GPU_INPUT_STREAM=tts_requests
GPU_OUTPUT_STREAM=tts_results
GPU_STREAM=gpu_tts_requests
GPU_RESULTS_STREAM=gpu_tts_results
# Группа потребителей для распределения задач
GPU_CONSUMER_GROUP=gpu_workers

# === GPU РАБОТНИКИ (Workers) ===
# Минимальное количество параллельных воркеров
GPU_MIN_CONCURRENT=1
# Максимальное количество параллельных воркеров
GPU_MAX_CONCURRENT=4
# Начальное количество воркеров при старте
GPU_INITIAL_CONCURRENT=2

# === GPU ПАМЯТЬ (Thresholds) ===
# Порог низкой загрузки памяти (30% = можно добавить воркеры)
GPU_MEMORY_THRESHOLD_LOW=0.3
# Порог высокой загрузки памяти (80% = не добавлять воркеры)
GPU_MEMORY_THRESHOLD_HIGH=0.8
# Критический порог памяти (90% = срочно освободить память)
GPU_MEMORY_THRESHOLD_CRITICAL=0.9

# === GPU МОНИТОРИНГ ===
# Интервал проверки GPU (секунд)
GPU_MONITORING_INTERVAL=5.0
# Размер истории метрик для анализа
GPU_HEALTH_HISTORY_SIZE=100

# === GPU ЗАДАЧИ ===
# Максимальное время выполнения одной задачи (секунд)
GPU_TASK_TIMEOUT=300.0
# Размер батча для обработки (количество задач за раз)
GPU_BATCH_SIZE=10
# Количество попыток при ошибке
GPU_RETRY_ATTEMPTS=3
# Задержка между попытками (секунд)
GPU_RETRY_DELAY=5.0

# === WORKER ID ===
# Уникальный ID воркера (для логирования и мониторинга)
WORKER_ID=worker_1