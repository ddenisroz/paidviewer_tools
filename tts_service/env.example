# ===================================
# TTS SERVICE - DEVELOPMENT CONFIGURATION
# ===================================

# === ОСНОВНЫЕ НАСТРОЙКИ ===
ENVIRONMENT=development
TTS_DEBUG=true
TTS_LOG_LEVEL=DEBUG

# === СЕРВЕР ===
TTS_HOST=0.0.0.0
TTS_PORT=8001
TTS_WORKERS=1  # Для dev, в prod используйте 4+

# === DATABASE ===
DATABASE_URL=sqlite:///./tts_service.db

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# === HUGGING FACE ===
# Кеш для моделей TTS
HF_HOME=./f5_tts_cache
HUGGINGFACE_HUB_CACHE=./f5_tts_cache
HUGGINGFACE_TOKEN=your_huggingface_token

# === TTS НАСТРОЙКИ ===
TTS_MAX_MESSAGE_LENGTH=500
TTS_DEFAULT_VOICE=female_russian
TTS_CACHE_DIR=./audio/cache
TTS_VOICES_DIR=./audio/voices

# === AUDIO НАСТРОЙКИ ===
AUDIO_SAMPLE_RATE=24000
AUDIO_FORMAT=wav
AUDIO_BITRATE=192k
MAX_AUDIO_FILE_SIZE=10485760  # 10 MB

# === ЛОГИРОВАНИЕ ===
LOG_LEVEL=DEBUG
LOG_DIR=./logs
ENABLE_JSON_LOGS=false  # true для production
ENABLE_LOG_ROTATION=true

# === БЭКАПЫ ===
ENABLE_AUTO_BACKUP=true
MAX_DB_BACKUPS=30
MAX_CONFIG_BACKUPS=7
MAX_LOGS_BACKUPS=7
MAX_AUDIO_BACKUPS=3
MAX_MODELS_BACKUPS=1

# === PERFORMANCE ===
# Максимальное количество одновременных запросов
MAX_CONCURRENT_REQUESTS=5
# Таймаут генерации TTS (секунды)
TTS_GENERATION_TIMEOUT=30

# === ИНСТРУКЦИИ ===
# 1. Скопируйте файл: cp env.example .env
# 2. Заполните HUGGINGFACE_TOKEN
# 3. Для production используйте env.production.example
# 4. Перезапустите сервис после изменений
