# Frontend - Минимальная конфигурация
# Только используемые переменные

# === API URLS ===
VITE_BOT_SERVICE_URL=http://localhost:8000
VITE_TTS_SERVICE_URL=http://localhost:8001

# === WEBSOCKET ===
VITE_BOT_SERVICE_WS_URL=ws://localhost:8000

# === WEBSOCKET CONNECTION LIMITS ===
# Максимальное количество одновременных попыток подключения (увеличено для стрим-платформы)
VITE_WS_MAX_GLOBAL_ATTEMPTS=20
# Интервал сброса счетчика попыток (в миллисекундах) - уменьшен для быстрого восстановления
VITE_WS_RESET_INTERVAL_MS=15000
# Максимальная задержка переподключения (в миллисекундах) - уменьшена для быстрого восстановления
VITE_WS_MAX_RECONNECT_DELAY=5000
# Базовый интервал переподключения (в миллисекундах) - уменьшен для быстрого восстановления
VITE_WS_RECONNECT_INTERVAL=1000
# Максимальное количество попыток переподключения - увеличено для надежности
VITE_WS_MAX_RECONNECT_ATTEMPTS=10
# Интервал heartbeat (в миллисекундах, 0 = отключено) - уменьшен для быстрого обнаружения разрывов
VITE_WS_HEARTBEAT_INTERVAL=15000
# Задержка перед первым подключением (в миллисекундах) - уменьшена для быстрого старта
VITE_WS_INITIAL_CONNECT_DELAY=50

# === CHAT ===
# Максимальное количество сообщений в чате (увеличено для активного чата)
VITE_CHAT_MAX_MESSAGES=500

# === TTS HEALTH CHECK ===
# Минимальный интервал между проверками здоровья TTS (в миллисекундах) - уменьшен для быстрого обнаружения проблем
VITE_TTS_MIN_CHECK_INTERVAL=1000
# Таймаут принудительного завершения проверки (в миллисекундах) - уменьшен для быстрого восстановления
VITE_TTS_FORCE_COMPLETE_TIMEOUT=3000
# Таймаут проверки TTS сервера (в миллисекундах) - уменьшен для быстрого ответа
VITE_TTS_HEALTH_CHECK_TIMEOUT=2000
# Задержка перед первой проверкой (в миллисекундах) - уменьшена для быстрого старта
VITE_TTS_INITIAL_CHECK_DELAY=50

# === STREAMING PLATFORM OPTIMIZATIONS ===
# Включить агрессивное переподключение для стрим-платформы
VITE_WS_AGGRESSIVE_RECONNECT=true
# Максимальное время ожидания перед показом ошибки подключения (в миллисекундах)
VITE_WS_CONNECTION_TIMEOUT=10000
# Интервал проверки состояния соединения (в миллисекундах)
VITE_WS_STATUS_CHECK_INTERVAL=5000
# Включить детальное логирование WebSocket для отладки
VITE_WS_DEBUG_LOGGING=false

# === FRONTEND ===
VITE_FRONTEND_URL=http://localhost:5173