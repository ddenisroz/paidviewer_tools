# Multi-stage build for production
FROM node:22-alpine as builder

WORKDIR /app

ARG VITE_BOT_SERVICE_URL=http://localhost:8000
ARG VITE_BOT_SERVICE_WS_URL=ws://localhost:8000

ENV VITE_BOT_SERVICE_URL=$VITE_BOT_SERVICE_URL
ENV VITE_BOT_SERVICE_WS_URL=$VITE_BOT_SERVICE_WS_URL

# Install dependencies
COPY package*.json ./
RUN npm ci

# Build static assets
COPY . .
RUN npm run build

# Production stage with Nginx
FROM nginx:alpine

# Compose healthcheck uses curl.
RUN apk add --no-cache curl

# Copy built frontend
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
