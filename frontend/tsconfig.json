{
  "compilerOptions": {
    // === Базовые настройки ===
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    
    // === Постепенная миграция ===
    "allowJs": true,              // Разрешить JS файлы для постепенной миграции
    "checkJs": true,              // Проверять JS файлы с помощью TypeScript
    "noEmit": true,               // Не генерировать файлы (Vite делает это)
    
    // === Строгость типизации (постепенно увеличивать) ===
    "strict": false,              // Начнем с false, затем включим постепенно
    "noImplicitAny": false,       // Позволить any для постепенной миграции
    "strictNullChecks": false,     // Позволить null/undefined для постепенной миграции
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "alwaysStrict": false,
    
    // === Дополнительные проверки ===
    "noUnusedLocals": false,       // Отключено для постепенной миграции
    "noUnusedParameters": false,   // Отключено для постепенной миграции
    "noImplicitReturns": false,    // Отключено для постепенной миграции
    "noFallthroughCasesInSwitch": true,
    
    // === Пути и алиасы ===
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,      // Требовать для Vite
    
    // === Дополнительные опции ===
    "skipLibCheck": true,         // Пропустить проверку типов библиотек (быстрее)
    "esModuleInterop": true,      // Совместимость с CommonJS
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    
    // === Source Maps ===
    "sourceMap": true,
    "inlineSourceMap": false,
    "inlineSources": false,
    
    // === Дополнительные типы ===
    "types": ["vite/client", "node", "jest", "@testing-library/jest-dom"]
  },
  "include": [
    "src/**/*",
    "vite.config.js",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "src/tests/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.js",
    "**/*.test.jsx"
  ],
  "ts-node": {
    "esm": true
  }
}

