# ========================================
# TTS_TTV Frontend - РЕАЛЬНАЯ КОНФИГУРАЦИЯ
# ========================================

# ========================================
# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ
# ========================================

# Bot Service URL (VDS сервер)
VITE_BOT_SERVICE_URL=http://localhost:8000    # URL Bot сервиса на VDS

# TTS Service URL (ваш ПК)
VITE_TTS_SERVICE_URL=http://localhost:8001    # URL TTS сервиса на вашем ПК
# ВАЖНО: Для продакшена используйте прокси или VPN!
# Примеры безопасных URL:
# VITE_TTS_SERVICE_URL=https://tts.yourdomain.com
# VITE_TTS_SERVICE_URL=https://your-ngrok-url.ngrok.io

# WebSocket URL
VITE_BOT_WS_URL=ws://localhost:8000/ws        # WebSocket для чата

# ========================================
# ДЛЯ ПРОДАКШЕНА
# ========================================

# Замените на ваши домены:
# VITE_BOT_SERVICE_URL=https://bot.yourdomain.com
# VITE_TTS_SERVICE_URL=http://YOUR_PC_IP:8001
# VITE_BOT_WS_URL=wss://bot.yourdomain.com/ws
